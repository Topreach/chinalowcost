# Copy to .env. Never put these values in outputs/ or browser settings.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=
# This initial implementation deliberately accepts sk_test_ keys only.
EMAIL_PROVIDER=disabled
# Set EMAIL_PROVIDER=smtp to enable receipts using your business mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=support@chinalowcost.com
SUPPORT_EMAIL=support@chinalowcost.com
DATABASE_FILE=./data/app.sqlite
# Optional locally; production requires a stable 64-character hexadecimal key.
# Preserve this key securely with database backups to retain MFA access.
APP_ENCRYPTION_KEY=
# Absolute path to an installed, updated ClamAV clamscan executable.
# Uploads remain disabled if this is empty.
CLAMSCAN_PATH=
UPLOAD_DIRECTORY=./data/private-files

# Trust only proxies directly in your controlled reverse-proxy chain.
TRUSTED_PROXY_CIDRS=

# Live mode requires a separate fresh .live.sqlite database, production HTTPS and explicit activation.
PAYMENT_MODE=test
LIVE_PAYMENTS_ENABLED=false

# Public recipient key only; keep its private key off this server.
BACKUP_PUBLIC_KEY_FILE=

# Optional Android download path; defaults to public-downloads beside the data folder.
MOBILE_APK_FILE=
