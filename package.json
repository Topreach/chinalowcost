{
  "name": "chinalowcost-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "ChinaLowCost editable customer, worker and admin prototype",
  "scripts": {
    "start": "node --env-file=.env backend/server.cjs",
    "order:approve": "node --env-file=.env backend/approve-order.cjs",
    "account:create": "node --env-file=.env backend/create-account.cjs",
    "backup": "node --env-file=.env backend/backup.cjs",
    "backup:check": "node --env-file=.env backend/backup.cjs --check",
    "test:backend": "node --test backend/test/*.test.cjs",
    "build": "node work/build-prototype.cjs && node work/build-storefront.cjs",
    "test": "node work/check-connected-prototype.cjs && node work/check-accounts.cjs && node work/check-server-connected.cjs && node --test backend/test/*.test.cjs",
    "backup:encrypted": "node --env-file=.env backend/backup-encrypted.cjs",
    "backup:keygen": "node backend/backup-encrypted.cjs --keygen",
    "mobile:build": "npm --prefix mobile run build",
    "mobile:test": "npm --prefix mobile test",
    "mobile:android": "npm --prefix mobile run android"
  },
  "dependencies": {
    "imapflow": "^2.5.2",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.1.1",
    "qrcode": "1.5.4",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
